      "html": "<div class=\"ds-roof\"><nav class=\"ds-roof-nav\"><a aria-current=\"page\" href=\"#\">Dashboard</a><a href=\"#\">Memorisation</a><a href=\"#\">Murajaah</a></nav></div><div class=\"ds-eave\"></div>",
      "css": ".ds-roof{background:var(--roof);height:56px;display:flex;align-items:center;padding:0 24px}.ds-roof-nav{display:flex;gap:4px}.ds-roof-nav a{padding:4px 10px;border-radius:0;font:400 14px/1.4 var(--font-archivo),ui-sans-serif,system-ui,sans-serif;color:oklch(0.95 0.008 180 / 85%);text-decoration:none;transition:background .15s}.ds-roof-nav a:hover{background:oklch(0.95 0.008 180 / 10%);color:oklch(0.95 0.008 180)}.ds-roof-nav a[aria-current=page]{background:oklch(0.95 0.008 180 / 15%);color:oklch(0.95 0.008 180);font-weight:600}.ds-roof-nav a:focus-visible{outline:2px solid oklch(0.74 0.1 180);outline-offset:2px}.ds-eave{height:22px;background:var(--roof);-webkit-mask:conic-gradient(from 111.45deg at top,#000 137.1deg,#0000 0) 0 0/112px 100% repeat-x;mask:conic-gradient(from 111.45deg at top,#000 137.1deg,#0000 0) 0 0/112px 100% repeat-x}"
